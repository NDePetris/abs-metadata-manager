# Copy to .env locally. Never commit credentials.
ABS_SERVER=http://localhost:13378
ABS_TOKEN=
# ABS_URL is accepted as a legacy alias for ABS_SERVER.
ABS_LIBRARY=
# Blank auto-detects PATH, .tools/abs-cli.exe, then the standard Windows install.
ABS_CLI_PATH=
ABS_MM_DB=data/metadata.sqlite3
ABS_MM_INTERVAL=1.5
ABS_MM_TIMEOUT=90
